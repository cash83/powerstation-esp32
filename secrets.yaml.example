# Rinomina questo file in "secrets.yaml" e mettici i TUOI valori.
# Va nella cartella dell'addon ESPHome del box (/config/esphome/secrets.yaml).
# NON contiene i valori veri: solo i nomi dei campi che lo yaml si aspetta.

wifi_ssid: "NOME_DELLA_TUA_RETE_WIFI"
wifi_password: "PASSWORD_WIFI"

# Chiave di cifratura API (HA <-> ESP). 32 byte in base64.
# Generala su https://esphome.io/components/api  (pulsante "generate") oppure riusa quella attuale.
api_encryption_key: "CHIAVE_BASE64_32BYTE"

# Password per gli aggiornamenti OTA via WiFi.
ota_password: "PASSWORD_OTA"
